# ─── Servidor ─────────────────────────────────────────────────────────────────
# Contraseña maestra para acceder al juego (cámbiala por algo seguro)
MASTER_PASSWORD=BadajozParty2025

# Puerto del servidor (en Render se asigna automáticamente con la variable PORT)
PORT=3000

# URL pública del servidor (necesaria para generar los QR correctamente en producción)
# En Render, establécela como: https://badajoz-party.onrender.com (o tu nombre de servicio)
PUBLIC_URL=http://localhost:3000

# Minutos de inactividad antes de eliminar una sala vacía (por defecto: 30)
ROOM_CLEANUP_MINUTES=30
